.flex.flex--column.flex--spaced-out.flex--centered.flex--no-wrap.center.dr__image-cell
  p
    = if is_nil(@image) do
      | (Image now hard-deleted)
    - else
      | #
      = @image.id

  .dupe-report-list--image-container = render PhilomenaWeb.ImageView, "_image_container.html", image: @image, size: :thumb_small, conn: @conn

  p
    = @image.image_width
    | x
    = @image.image_height

  p
    = render PhilomenaWeb.UserAttributionView, "_anon_user.html", object: @image, conn: @conn

  = if can?(@conn, :edit, @report) and mergeable?(@report) do
    = if @source do
      = form_for @conn, ~p"/duplicate_reports/#{@report}/accept_reverse", [method: "post", class: "button_to js-duplicate-report", data: [remote: "true"]], fn _f ->
        button.button.button--separate-right type="submit" data-disable-with="Loading…"
          ' Keep Source
          i.fa.fa-arrow-left
    - else
      = form_for @conn, ~p"/duplicate_reports/#{@report}/accept", [method: "post", class: "button_to js-duplicate-report", data: [remote: "true"]], fn _f ->
        button.button.button--separate-right type="submit" data-disable-with="Loading…"
          i.fa.fa-arrow-right>
          | Keep Target
