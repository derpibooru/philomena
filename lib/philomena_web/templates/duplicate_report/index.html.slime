h1 Duplicate Reports

= form_for @changeset, ~p"/duplicate_reports", [as: :dq, method: :get], fn f ->
  .field.field.field--inline
    = for {label, state} <- states() do
      label.checkbox-button.button.button--separate-right
        input.checkbox-button__checkbox name="#{input_name(f, :states)}[]" type="checkbox" checked=Enum.member?(f.data.states, state) value=state
        span.checkbox-button__label = label
    = select f, :sd, sorts(), class: "input input--separate-right"
    = submit "Search", class: "button button--state-primary"
  .errors
    = error_tag f, :states
    = error_tag f, :sd

= if @duplicate_reports do
  - route = fn p -> ~p"/duplicate_reports?#{p}" end
  - pagination = render PhilomenaWeb.PaginationView, "_pagination.html", page: @duplicate_reports, route: route, conn: @conn, params: [dq: @conn.params["dq"]]

  .block
    .block__header.page__header
      .page__pagination = pagination

    = render PhilomenaWeb.DuplicateReportView, "_list.html", duplicate_reports: @duplicate_reports, conn: @conn

    .block
      .block__header.block__header--light.page__header
        .page__pagination = pagination
